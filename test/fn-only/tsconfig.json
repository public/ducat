    "../../src/entries/drizzle-mysql.ts",
    "../../src/entries/drizzle-pg.ts",
    "../../src/entries/drizzle-sqlite.ts",
    "../../src/entries/ecb.ts",
    "../../src/entries/fed.ts",
    "../../src/entries/fetch.ts",
    "../../src/entries/finance.ts",
    "../../src/entries/historic.ts",
    "../../src/entries/history.ts",
    "../../src/entries/hmrc.ts",
    "../../src/entries/kysely.ts",
    "../../src/entries/parse.ts",
    "../../src/entries/pg.ts",
    "../../src/entries/policy.ts",
