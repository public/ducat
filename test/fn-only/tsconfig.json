    "../../src/ecb.ts",
    "../../src/fed.ts",
    "../../src/fetch.ts",
    "../../src/finance.ts",
    "../../src/fixed.ts",
    "../../src/fn.ts",
    "../../src/historic.ts",
    "../../src/history.ts",
    "../../src/hmrc.ts",
    "../../src/iso.ts",
    "../../src/kysely.ts",
    "../../src/parse.ts",
