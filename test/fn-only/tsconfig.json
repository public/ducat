// Type-checks every entry that doesn't install the Money methods (/fn and the non-plugin entries,
// including the ones built against optional peers). Without the root entry those programs have no
// methods, so library code that calls one (m.toDecimal() instead of toDecimal(m)) is a compile
// error here instead of a run-time one.
{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": "../../src",
    "lib": ["ES2023", "ESNext.Intl", "DOM"],
    "skipLibCheck": true
  },
  "include": [],
  "files": [
    "../../src/adyen-fx.ts",
    "../../src/boc.ts",
    "../../src/boe.ts",
    "../../src/crypto.ts",
