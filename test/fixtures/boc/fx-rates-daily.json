    "groupDetail": {
        "label": "Daily exchange rates",
        "description": "Daily average exchange rates for various foreign currencies currently or historically published by the Bank of Canada, representing the value of one unit of foreign currency expressed in Canadian dollars. These rates are typically published once each business day by 16:30 (ET). All Bank of Canada exchange rates are indicative rates only, obtained from averages of aggregated price quotes from financial institutions.",
        "link": "https://www.bankofcanada.ca/?p=190892",
        "metadata": {
            "unit": "Canadian dollars per foreign currency unit",
            "frequency": "Business daily"
        }
    },
