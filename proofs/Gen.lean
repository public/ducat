import Ducat.Rounding

/-! `lake exe gen > ../src/generated/kernel.ts`: prints the proved kernels as TypeScript. -/

open Ducat

def header : String :=
  "// GENERATED by proofs/Gen.lean (`npm run gen:kernel`). Do not edit.\n" ++
  "// Each function is printed from a `Prog` value whose behaviour is proved in proofs/Ducat/*.lean:\n" ++
  "// see `kernel_sound`, `kernel_fails_iff` and `rounds_unique` in proofs/Ducat/Rounding.lean.\n" ++
  "import { RoundingError } from '../rounding.js';\n\n" ++
  "function fail(): never {\n" ++
  "  throw new RoundingError('Rounding necessary: the result is not exact; pass a rounding mode');\n" ++
  "}\n\n"

def table : String :=
  let entries := Mode.all.map fun m => s!"  {m.tsName}: {(kernel m).name},"
  "/** Proved `divRound` for each rounding mode, keyed by the mode string. */\n" ++
  "export const DIV_ROUND_BIG: Readonly<Record<string, (p: bigint, d: bigint) => bigint>> = {\n" ++
  "\n".intercalate entries ++ "\n};\n"

def main : IO Unit := do
  IO.print header
  for m in Mode.all do
    IO.println (kernel m).toTS
  IO.print table
