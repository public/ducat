{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023", "ESNext.Intl"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "exactOptionalPropertyTypes": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "verbatimModuleSyntax": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "types": [],
    // the private vectors package (spec/), for the tests; ducat's package.json doesn't name it,
    // and vitest.config.ts resolves it the same way. Nothing in src/ imports it.
    "paths": { "@ducatjs/money-spec/*": ["./spec/*"] }
  },
  "include": ["src"],
  // built by tsconfig.drizzle.json (skipLibCheck for drizzle-orm's declarations),
  // tsconfig.kysely.json (the DOM library for kysely's) and tsconfig.peers.json (the entries built
  // against the optional peers zod, valibot, vitest and fast-check)
  "exclude": [
    "src/drizzle",
    "src/kysely.ts",
    "src/zod.ts",
    "src/valibot.ts",
    "src/testing/vitest.ts",
    "src/testing/arbitraries.ts",
    "src/entries/drizzle-*.ts",
    "src/entries/kysely.ts",
    "src/entries/zod.ts",
    "src/entries/valibot.ts",
    "src/entries/testing-vitest.ts",
    "src/entries/testing-arbitraries.ts"
  ]
}
