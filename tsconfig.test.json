{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    // the private vectors package, which ducat's own package.json doesn't name (vitest.config.ts
    // resolves it the same way)
    "paths": { "@ducatjs/money-spec/*": ["./spec/*"] }
  },
  "include": ["src", "test", "bench"],
  "exclude": [
    "test/core-only",
    "test/plugin-types",
    "test/browser",
    "src/drizzle",
    "src/entries/drizzle-*.ts",
    "test/db/drizzle.test.ts",
    "test/jest-types"
  ]
}
