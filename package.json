{
  "name": "@ducatjs/money",
  "version": "0.1.0",
  "description": "Exact, fast, typed Money for TypeScript: integer minor units, bigint fallback, Stripe/Adyen views, allocation, cash rounding, Prisma helpers.",
  "homepage": "https://github.com/public/ducat#readme",
  "bugs": {
    "url": "https://github.com/public/ducat/issues"
  },
  "license": "MIT",
  "author": "Alex Stapleton <alexs@prol.etari.at>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/public/ducat.git"
  },
  "files": [
    "dist",
    "src",
    "data",
    "assets/CREDITS.md",
    "NOTICE",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/plugins/*.js",
    "./src/plugins/*.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fn": {
      "types": "./dist/fn.d.ts",
      "default": "./dist/fn.js"
    },
    "./allocate": {
      "types": "./dist/plugins/allocate.d.ts",
      "default": "./dist/plugins/allocate.js"
    },
    "./tax": {
      "types": "./dist/plugins/tax.d.ts",
      "default": "./dist/plugins/tax.js"
    },
    "./convert": {
      "types": "./dist/plugins/convert.d.ts",
      "default": "./dist/plugins/convert.js"
    },
    "./convert/ecb": {
      "types": "./dist/ecb.d.ts",
      "default": "./dist/ecb.js"
    },
    "./convert/history": {
      "types": "./dist/history.d.ts",
      "default": "./dist/history.js"
    },
    "./convert/fetch": {
      "types": "./dist/fetch.d.ts",
      "default": "./dist/fetch.js"
    },
    "./exact": {
      "types": "./dist/plugins/exact.d.ts",
      "default": "./dist/plugins/exact.js"
    },
    "./policy": {
      "types": "./dist/policy.d.ts",
      "default": "./dist/policy.js"
    },
    "./cash": {
      "types": "./dist/plugins/cash.d.ts",
      "default": "./dist/plugins/cash.js"
    },
    "./format": {
      "types": "./dist/plugins/format.d.ts",
      "default": "./dist/plugins/format.js"
    },
    "./fixed": {
      "types": "./dist/plugins/fixed.d.ts",
      "default": "./dist/plugins/fixed.js"
    },
    "./parse": {
      "types": "./dist/parse.d.ts",
      "default": "./dist/parse.js"
    },
    "./stripe": {
      "types": "./dist/plugins/stripe.d.ts",
      "default": "./dist/plugins/stripe.js"
    },
    "./adyen": {
      "types": "./dist/plugins/adyen.d.ts",
      "default": "./dist/plugins/adyen.js"
    },
    "./checkout": {
      "types": "./dist/plugins/checkout.d.ts",
      "default": "./dist/plugins/checkout.js"
    },
    "./paypal": {
      "types": "./dist/plugins/paypal.d.ts",
      "default": "./dist/plugins/paypal.js"
    },
    "./braintree": {
      "types": "./dist/plugins/braintree.d.ts",
      "default": "./dist/plugins/braintree.js"
    },
    "./klarna": {
      "types": "./dist/plugins/klarna.d.ts",
      "default": "./dist/plugins/klarna.js"
    },
    "./stripe-fx": {
      "types": "./dist/stripe-fx.d.ts",
      "default": "./dist/stripe-fx.js"
    },
    "./adyen-fx": {
      "types": "./dist/adyen-fx.d.ts",
      "default": "./dist/adyen-fx.js"
    },
    "./prisma": {
      "types": "./dist/plugins/prisma.d.ts",
      "default": "./dist/plugins/prisma.js"
    },
    "./drizzle/pg": {
      "types": "./dist/drizzle/pg.d.ts",
      "default": "./dist/drizzle/pg.js"
    },
    "./drizzle/mysql": {
      "types": "./dist/drizzle/mysql.d.ts",
      "default": "./dist/drizzle/mysql.js"
    },
    "./drizzle/sqlite": {
      "types": "./dist/drizzle/sqlite.d.ts",
      "default": "./dist/drizzle/sqlite.js"
    },
    "./zod": {
      "types": "./dist/zod.d.ts",
      "default": "./dist/zod.js"
    },
    "./valibot": {
      "types": "./dist/valibot.d.ts",
      "default": "./dist/valibot.js"
    },
    "./pg": {
      "types": "./dist/pg.d.ts",
      "default": "./dist/pg.js"
    },
    "./all": {
      "types": "./dist/plugins/all.d.ts",
      "default": "./dist/plugins/all.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.drizzle.json",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p tsconfig.test-drizzle.json && tsc -p test/core-only/tsconfig.json && tsc -p test/browser/tsconfig.json",
    "test": "vitest run",
    "test:deep": "DUCAT_DEEP=1 vitest run",
    "compare": "pnpm --dir compare battery && pnpm --dir compare tables",
    "compare:check": "pnpm --dir compare battery:check && pnpm --dir compare tables:check",
    "tables": "pnpm --dir compare tables",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:browser": "playwright test",
    "test:mutation": "DUCAT_MAX_RUNS=50 stryker run",
    "fetch:dectest": "node scripts/fetch-dectest.mjs",
    "vectors:check": "python3 scripts/gen-pydecimal-vectors.py --check",
    "test:runtimes": "node scripts/smoke-runtimes.mjs",
    "gen": "node scripts/gen-currencies.mjs",
    "gen:check": "node scripts/gen-currencies.mjs --check && node scripts/gen-kernel.mjs --verify",
    "gen:kernel": "node scripts/gen-kernel.mjs",
    "gen:kernel:check": "node scripts/gen-kernel.mjs --check",
    "gen:fetch": "node scripts/gen-currencies.mjs --check --fetch",
    "bench": "node scripts/bench-all.mjs",
    "size": "node scripts/size.mjs",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "pnpm lint && pnpm fmt:check && pnpm typecheck && pnpm size && pnpm test",
    "bench:vitest": "vitest bench --run"
  },
  "devDependencies": {
    "@codspeed/vitest-plugin": "6.1.1",
    "@playwright/test": "1.65.0",
    "@prisma/client": "^6.19.3",
    "@stryker-mutator/core": "10.1.1",
    "@stryker-mutator/vitest-runner": "10.1.1",
    "@types/better-sqlite3": "9.6.0",
    "@types/big.js": "^7.0.0",
    "@types/node": "^26.6.6",
    "@types/pg": "8.23.1",
    "better-sqlite3": "13.0.3",
    "big.js": "^7.0.1",
    "currency.js": "^2.0.4",
    "decimal.js": "^10.6.0",
    "dinero.js": "^2.0.2",
    "drizzle-orm": "0.45.4",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "mysql2": "3.24.6",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "pg": "8.23.1",
    "ts-money": "^0.4.8",
    "typescript": "^5.9.3",
    "valibot": "1.5.0",
    "vitest": "^4.1.12",
    "zod": "4.6.7"
  },
  "peerDependencies": {
    "drizzle-orm": ">=0.45.0 <1",
    "valibot": "^1.0.0",
    "zod": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "drizzle-orm": {
      "optional": true
    },
    "valibot": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.18.0"
}
