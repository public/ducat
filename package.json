  "scripts": {
    "check:consumers": "node scripts/check-consumer-types.mjs",
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.drizzle.json && tsc -p tsconfig.kysely.json && tsc -p tsconfig.peers.json",
    "typecheck": "tsc -p test/fn-only/tsconfig.json && tsc -p tsconfig.test.json && tsc -p tsconfig.test-drizzle.json && tsc -p test/core-only/tsconfig.json && tsc -p test/browser/tsconfig.json && tsc -p test/jest-types/tsconfig.json",
    "test": "vitest run",
    "test:deep": "DUCAT_DEEP=1 vitest run",
    "compare": "pnpm --dir compare battery && pnpm --dir compare tables",
    "compare:check": "pnpm --dir compare battery:check && pnpm --dir compare tables:check",
    "tables": "pnpm --dir compare tables",
    "test:db": "vitest run --config vitest.db.config.ts",
    "test:browser": "playwright test",
    "test:mutation": "DUCAT_MAX_RUNS=50 DUCAT_MUTATION=1 stryker run",
    "fetch:dectest": "node scripts/fetch-dectest.mjs",
    "vectors:check": "python3 scripts/gen-pydecimal-vectors.py --check && python3 scripts/gen-finance-vectors.py --check",
    "test:runtimes": "node scripts/smoke-runtimes.mjs",
    "gen": "node scripts/gen-currencies.mjs",
    "gen:check": "node scripts/gen-currencies.mjs --check && node scripts/gen-kernel.mjs --verify",
    "gen:kernel": "node scripts/gen-kernel.mjs",
    "gen:kernel:check": "node scripts/gen-kernel.mjs --check",
    "gen:fetch": "node scripts/gen-currencies.mjs --check --fetch",
    "bench": "node scripts/bench-all.mjs",
    "size": "node scripts/size.mjs",
    "lint": "oxlint --deny-warnings",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "pnpm lint && pnpm fmt:check && pnpm typecheck && pnpm size && pnpm test",
    "bench:vitest": "vitest bench --run"
  },
