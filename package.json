{
  "name": "ducat",
  "version": "0.1.0",
  "private": true,
  "description": "Exact, fast, typed Money for TypeScript: integer minor units, bigint fallback, Stripe/Adyen views, allocation, cash rounding, Prisma helpers.",
  "type": "module",
  "sideEffects": false,
  "license": "UNLICENSED",
  "author": "Alex Stapleton <alexs@prol.etari.at>",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./stripe": {
      "types": "./dist/stripe.d.ts",
      "default": "./dist/stripe.js"
    },
    "./adyen": {
      "types": "./dist/adyen.d.ts",
      "default": "./dist/adyen.js"
    },
    "./prisma": {
      "types": "./dist/prisma.d.ts",
      "default": "./dist/prisma.js"
    }
  },
  "files": [
    "dist",
    "src",
    "data"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:runtimes": "node scripts/smoke-runtimes.mjs",
    "gen": "node scripts/gen-currencies.mjs",
    "gen:check": "node scripts/gen-currencies.mjs --check",
    "gen:fetch": "node scripts/gen-currencies.mjs --check --fetch",
    "bench": "node scripts/bench-all.mjs",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "npm run lint && npm run fmt:check && npm run typecheck && npm test"
  },
  "devDependencies": {
    "@prisma/client": "^6.19.3",
    "@types/big.js": "^7.0.0",
    "@types/node": "^26.6.6",
    "big.js": "^7.0.1",
    "currency.js": "^2.0.4",
    "decimal.js": "^10.6.0",
    "dinero.js": "^2.0.2",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "ts-money": "^0.4.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
