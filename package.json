{
  "name": "@ducatjs/money",
  "version": "0.1.0",
  "private": true,
  "description": "Exact, fast, typed Money for TypeScript: integer minor units, bigint fallback, Stripe/Adyen views, allocation, cash rounding, Prisma helpers.",
  "license": "MIT",
  "author": "Alex Stapleton <alexs@prol.etari.at>",
  "files": [
    "dist",
    "src",
    "data",
    "assets/CREDITS.md",
    "NOTICE",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": [
    "./dist/plugins/*.js",
    "./src/plugins/*.ts"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fn": {
      "types": "./dist/fn.d.ts",
      "default": "./dist/fn.js"
    },
    "./allocate": {
      "types": "./dist/plugins/allocate.d.ts",
      "default": "./dist/plugins/allocate.js"
    },
    "./tax": {
      "types": "./dist/plugins/tax.d.ts",
      "default": "./dist/plugins/tax.js"
    },
    "./convert": {
      "types": "./dist/plugins/convert.d.ts",
      "default": "./dist/plugins/convert.js"
    },
    "./cash": {
      "types": "./dist/plugins/cash.d.ts",
      "default": "./dist/plugins/cash.js"
    },
    "./format": {
      "types": "./dist/plugins/format.d.ts",
      "default": "./dist/plugins/format.js"
    },
    "./parse": {
      "types": "./dist/parse.d.ts",
      "default": "./dist/parse.js"
    },
    "./stripe": {
      "types": "./dist/plugins/stripe.d.ts",
      "default": "./dist/plugins/stripe.js"
    },
    "./adyen": {
      "types": "./dist/plugins/adyen.d.ts",
      "default": "./dist/plugins/adyen.js"
    },
    "./prisma": {
      "types": "./dist/plugins/prisma.d.ts",
      "default": "./dist/plugins/prisma.js"
    },
    "./all": {
      "types": "./dist/plugins/all.d.ts",
      "default": "./dist/plugins/all.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json && tsc -p test/core-only/tsconfig.json",
    "test": "vitest run",
    "test:runtimes": "node scripts/smoke-runtimes.mjs",
    "gen": "node scripts/gen-currencies.mjs",
    "gen:check": "node scripts/gen-currencies.mjs --check",
    "gen:fetch": "node scripts/gen-currencies.mjs --check --fetch",
    "bench": "node scripts/bench-all.mjs",
    "lint": "oxlint",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "check": "pnpm lint && pnpm fmt:check && pnpm typecheck && pnpm test",
    "bench:vitest": "vitest bench --run"
  },
  "devDependencies": {
    "@codspeed/vitest-plugin": "6.1.1",
    "@prisma/client": "^6.19.3",
    "@types/big.js": "^7.0.0",
    "@types/node": "^26.6.6",
    "big.js": "^7.0.1",
    "currency.js": "^2.0.4",
    "decimal.js": "^10.6.0",
    "dinero.js": "^2.0.2",
    "esbuild": "^0.28.2",
    "fast-check": "^4.10.2",
    "oxfmt": "0.77.0",
    "oxlint": "1.92.0",
    "ts-money": "^0.4.8",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "engines": {
    "node": ">=24"
  },
  "packageManager": "pnpm@12.18.0"
}
