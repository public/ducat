{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "singleQuote": true,
  "ignorePatterns": [
    "proofs",
    "rust",
    "dist",
    "examples/prisma/generated",
    "bench/out",
    "src/generated",
    "test/fixtures",
    "data",
    "package-lock.json",
    "compare/results",
    "compare/RESULTS.md",
    "test/vectors",
    "spec/vectors"
  ]
}
